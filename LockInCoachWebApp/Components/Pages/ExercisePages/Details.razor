@page "/exercises/details"
@using Microsoft.EntityFrameworkCore
@using LockInCoachWebApp.Models
@inject IDbContextFactory<LockInCoachWebAppContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Exercise</h2>
    <hr />
    @if (exercise is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@exercise.Name</dd>
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@exercise.Description</dd>
            <dt class="col-sm-2">TargetMuscles</dt>
            <dd class="col-sm-10">@exercise.TargetMuscles</dd>
        </dl>
        <div>
            <a href="@($"/exercises/edit?id={exercise.Id}")">Edit</a> |
            <a href="@($"/exercises")">Back to List</a>
        </div>
    }
</div>

@code {
    private Exercise? exercise;

    [SupplyParameterFromQuery]
    private System.Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        exercise = await context.Exercise.FirstOrDefaultAsync(m => m.Id == Id);

        if (exercise is null)
        {
            NavigationManager.NotFound();
        }
    }
}
