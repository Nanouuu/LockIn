@page "/exercises/details"
@using LockInCoachWebApp.Components.Shared

<PageTitle>Exercise Details</PageTitle>

@if (exercise is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="details-container">

        <div class="details-image">
            <img src="@exercise.TargetMuscle.GetFakeImage()" />
        </div>

        <div class="details-content">

            <h1 class="exercise-title">@exercise.Name</h1>

            <div class="exercise-muscle">
                @exercise.TargetMuscle
            </div>

            <p class="exercise-description">
                @exercise.Description
            </p>

            <div class="details-actions">
                <a class="btn btn-primary"
                   href="@($"/exercises/edit?id={exercise.Id}")">
                    Edit
                </a>

                <button class="btn btn-danger" @onclick="ShowConfirm">
                    Delete
                </button>

                @if (exerciseToDelete is not null)
                {
                    <ConfirmModal IsVisible="true"
                                  Message="@($"Are you sure you want to delete {exerciseToDelete.Name}?")"
                                  ActionTitle="@("Delete")"
                                  OnConfirm="DeleteExercise"
                                  OnCancel="CancelDelete" />
                }

                <a class="btn btn-secondary"
                   href="/exercises">
                    Back
                </a>
            </div>

        </div>

    </div>
}