@page "/exercises/delete"
@using Microsoft.EntityFrameworkCore
@using LockInCoachWebApp.Models
@inject IDbContextFactory<LockInCoachWebAppContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Exercise</h2>
    <hr />
    @if (exercise is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@exercise.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@exercise.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">TargetMuscle</dt>
            <dd class="col-sm-10">@exercise.TargetMuscle</dd>
        </dl>
        <EditForm method="post" Model="exercise" OnValidSubmit="DeleteExercise" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(exercise is null)">Delete</button> |
            <a href="/exercises">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Exercise? exercise;

    [SupplyParameterFromQuery]
    private System.Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        exercise = await context.Exercise.FirstOrDefaultAsync(m => m.Id == Id);

        if (exercise is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteExercise()
    {
        using var context = DbFactory.CreateDbContext();
        context.Exercise.Remove(exercise!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/exercises");
    }
}
