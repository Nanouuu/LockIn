@page "/exercises"
@rendermode InteractiveServer
@using LockInCoachWebApp.Enums

<div @onclick="CloseDropdown">

    <PageTitle>Exercises</PageTitle>

    <h1>Exercises</h1>

    <p>
        <a href="exercises/create">Create New</a>
    </p>

    @if (exerciseList is null)
    {
        <p>Loading...</p>
    }
    else
    {
        <div class="d-flex gap-4 mb-4 align-items-start" >

            <div>
                <label class="form-label fw-semibold">Sort</label>
                <InputSelect @bind-Value="SortOrder" class="form-select">
                    <option value="AZ">A → Z</option>
                    <option value="ZA">Z → A</option>
                </InputSelect>
            </div>

            <div>
                <label class="form-label fw-semibold">Target muscles</label>

                <div class="filter-box mb-3" @onclick:stopPropagation="true">

                    <button class="filter-button" @onclick="ToggleDropdown">

                        <span class="filter-text">
                            @GetFilterLabel()
                        </span>

                        <span class="arrow">▾</span>

                    </button>

                    @if (isDropdownOpen)
                    {
                        <div class="filter-dropdown">

                            <div class="filter-header">
                                <span>Filter muscles</span>

                                @if (SelectedMuscles.Any())
                                {
                                    <button class="clear-btn" @onclick="ClearFilters">
                                        Clear
                                    </button>
                                }
                            </div>

                            <div class="filter-list">

                                @foreach (var muscle in Enum.GetValues<Muscle>())
                                {
                                    <div class="filter-item @(SelectedMuscles.Contains(muscle) ? "active" : "")"
                                         @onclick="() => ToggleMuscle(muscle)">
                                        @muscle
                                    </div>
                                }

                            </div>

                        </div>
                    }

                </div>
            </div>

        </div>

        <div class="exercise-grid">
            @foreach (var e in FilteredExercises)
            {
                <div class="exercise-card" @onclick="() => GoToDetails(e.Id)">

                    <div class="exercise-image">
                        <img src="@e.TargetMuscle.GetFakeImage()" />
                    </div>

                    <div class="exercise-content">
                        <div class="exercise-name">@e.Name</div>
                        <div class="exercise-muscle">@e.TargetMuscle</div>
                    </div>

                </div>
            }
        </div>
    }
</div>