@page "/exercises/edit"
@using Microsoft.EntityFrameworkCore
@using LockInCoachWebApp.Models
@using LockInCoachWebApp.Enum
@inject IDbContextFactory<LockInCoachWebAppContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Exercise</h2>
<hr />
@if (Exercise is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Exercise" OnValidSubmit="UpdateExercise" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Exercise.Id" value="@Exercise.Id" />
                <div class="mb-3">
                <span class="text-danger">*</span>
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Exercise.Name" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Exercise.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                <span class="text-danger">*</span>
                    <label for="description" class="form-label">Description:</label>
                    <InputText id="description" @bind-Value="Exercise.Description" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Exercise.Description" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="targetmuscles" class="form-label">TargetMuscles:</label> <InputSelect id="targetmuscles"
                                                                                                  @bind-Value="Exercise.TargetMuscles"
                                                                                                  class="form-control">
                    @foreach (var muscle in Enum.GetValues(typeof(Muscle)))
                    {
                        <option value="@muscle">@muscle</option>
                    }

                </InputSelect>
                <ValidationMessage For="() => Exercise.TargetMuscles" class="text-danger" />
            </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/exercises">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private System.Guid Id { get; set; }

    [SupplyParameterFromForm]
    private Exercise? Exercise { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Exercise ??= await context.Exercise.FirstOrDefaultAsync(m => m.Id == Id);

        if (Exercise is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateExercise()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Exercise!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ExerciseExists(Exercise!.Id))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/exercises");
    }

    private bool ExerciseExists(System.Guid id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Exercise.Any(e => e.Id == id);
    }
}
