@page "/exercises/edit"
@rendermode InteractiveServer

@using LockInCoachWebApp.Enums

<PageTitle>Edit Exercise</PageTitle>

<h1>Edit Exercise</h1>

<hr />

@if (exercise is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="exercise" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Name</label>
            <InputText class="form-control" @bind-Value="exercise.Name" />
        </div>

        <div class="mb-3">
            <label>Description</label>
            <InputText class="form-control" @bind-Value="exercise.Description" />
        </div>

        <div class="mb-3">
            <label>Target muscle</label>

            <InputSelect class="form-control" @bind-Value="exercise.TargetMuscle">
                @foreach (Muscle muscle in Enum.GetValues(typeof(Muscle)))
                {
                    <option value="@muscle">@muscle</option>
                }
            </InputSelect>

        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-secondary ms-2" href="/exercises">Cancel</a>
    </EditForm>
}