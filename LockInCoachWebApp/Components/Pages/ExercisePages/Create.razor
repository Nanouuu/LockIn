@page "/exercises/create"

@using LockInCoachWebApp.Models
@using LockInCoachWebApp.Enums

<PageTitle>Create Exercise</PageTitle>

<div class="container mt-4">
    <h2 class="mb-1">New Exercise</h2>
    <p class="text-muted mb-4">Fill in the information below</p>
    <hr />

    <div class="row">
        <div class="col-md-6">

            <EditForm method="post"
                      Model="@Exercise"
                      OnValidSubmit="AddExercise"
                      FormName="create"
                      Enhance>

                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="name" class="form-label fw-semibold">
                        Name <span class="text-danger">*</span>
                    </label>

                    <InputText id="name"
                               @bind-Value="Exercise!.Name"
                               class="form-control"
                               placeholder="Bench Press" />

                    <ValidationMessage For="() => Exercise.Name"
                                       class="text-danger small mt-1" />
                </div>

                <div class="mb-3">
                    <label for="targetmuscle" class="form-label fw-semibold">
                        Target Muscle <span class="text-danger">*</span>
                    </label>

                    <InputSelect id="targetmuscle"
                                 @bind-Value="Exercise!.TargetMuscle"
                                 class="form-select">

                        @foreach (var muscle in Enum.GetValues<Muscle>())
                        {
                            <option value="@muscle">@muscle</option>
                        }

                    </InputSelect>

                    <ValidationMessage For="() => Exercise.TargetMuscle"
                                       class="text-danger small mt-1" />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label fw-semibold">
                        Description <span class="text-danger">*</span>
                    </label>

                    <InputTextArea id="description"
                                   @bind-Value="Exercise!.Description"
                                   class="form-control"
                                   rows="5"
                                   placeholder="Describe the exercise..." />

                    <ValidationMessage For="() => Exercise.Description"
                                       class="text-danger small mt-1" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Create
                    </button>

                    <a href="/exercises"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </EditForm>

        </div>
    </div>
</div>