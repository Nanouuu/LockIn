@page "/training-programs/{ProgramId:guid}"
@using LockInCoachWebApp.Components.Shared

@if (program is null)
{
    <p>Program is not found</p>
    <a href="/training-programs"
       class="btn btn-outline-secondary">
        Back
    </a>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">@program?.Name</h1>

            <p class="text-muted mb-0">
                @program?.NumberOfWeeks weeks program
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">

            <a href="/training-programs"
               class="btn btn-outline-secondary">
                ← Back
            </a>

            <button class="btn btn-danger"
                    @onclick="ChangeProgramDeleteStatus">
                Delete
            </button>

        </div>

    </div>

    @for (int week = 1; week <= program?.NumberOfWeeks; week++)
    {
        <div class="week-container">

            <h3 class="mt-4">
                Week @week
            </h3>

            <div class="week-grid">

                @foreach (var day in days)
                {
                    var workout = GetWorkout(week, day);

                    <div class="day-card">

                        <h5>@day</h5>

                        @if (workout is null)
                        {
                            <div class="empty-state">
                                <p>No workout</p>
                            </div>
                        }
                        else if (workout.IsRestDay)
                        {
                            <span class="badge bg-secondary">
                                Rest Day
                            </span>
                        }
                        else
                        {
                            <strong>@workout.Name</strong>
                        }

                    </div>
                }

            </div>

        </div>
    }
}

@if (programDelete && program is not null)
{
    <ConfirmModal IsVisible="true"
                  Message="@($"Are you sure you want to delete {program.Name}?")"
                  ActionTitle="Delete"
                  OnConfirm="DeleteProgram"
                  OnCancel="ChangeProgramDeleteStatus" />
}