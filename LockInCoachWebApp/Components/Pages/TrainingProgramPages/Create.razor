@page "/training-programs/create"

<h1>Create Training Program</h1>

<div class="card shadow-sm">
    <div class="card-body">

        <EditForm Model="model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="alert alert-danger">
                        @error
                    </div>
                }
                <label class="form-label">Athlete</label>

                <InputSelect class="form-select" @bind-Value="model.AthleteId">

                    <option value="@Guid.Empty" disabled hidden>
                        Select an athlete
                    </option>

                    @foreach (var athlete in athletes)
                    {
                        <option value="@athlete.Id">
                            @athlete.FirstName @athlete.LastName
                        </option>
                    }

                </InputSelect>

                <ValidationMessage For="@(() => model.AthleteId)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Program Name</label>

                <InputText class="form-control"
                           @bind-Value="model.Name" 
                           placeholder="Enter program name"/>

                <ValidationMessage For="@(() => model.Name)" />
            </div>

            <div class="row">

                <div class="col-md-6">
                    <label class="form-label">Start Date</label>

                    <InputDate class="form-control"
                               @bind-Value="model.StartDate" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Number Of Weeks</label>

                    <InputNumber class="form-control"
                                 @bind-Value="model.NumberOfWeeks" />
                </div>

            </div>

            <div class="mt-4">
                <button class="btn btn-primary" type="submit">
                    Create Program
                </button>
                <a href="/training-programs"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>

        </EditForm>

    </div>
</div>