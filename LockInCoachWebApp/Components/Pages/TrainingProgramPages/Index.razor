@page "/training-programs"

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0">Training Programs</h1>
        <p class="text-muted mb-0">Manage your training programs</p>
    </div>

    <a class="btn btn-primary" href="training-programs/create">
        + New Program
    </a>
</div>

<div class="mb-3">
    <label class="form-label">Select athlete</label>

    <select class="form-select" @bind="SelectedAthleteId">
        <option value="">All athletes</option>

        @foreach (var a in athletes)
        {
            <option value="@a.Id">@a.FirstName @a.LastName</option>
        }
    </select>
</div>

@if (programsFiltered is null)
{
    <p>Loading...</p>
}
else if (!programsFiltered.Any())
{
    <p>No programs found</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Start</th>
                <th>End</th>
                <th>Weeks</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var p in programsFiltered)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.StartDate.ToShortDateString()</td>
                    <td>@GetEndDate(p).ToShortDateString()</td>
                    <td>@p.NumberOfWeeks</td>
                </tr>
            }
        </tbody>
    </table>
}