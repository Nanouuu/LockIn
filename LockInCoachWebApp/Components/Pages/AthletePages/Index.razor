@page "/athletes"
@using LockInCoachWebApp.Components.Shared
@using Microsoft.AspNetCore.Components.QuickGrid
@rendermode InteractiveServer

<PageTitle>Athletes</PageTitle>

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0">Athletes</h1>
            <p class="text-muted mb-0">Manage your athletes list</p>
        </div>

        <a class="btn btn-primary" href="athletes/create">
            + New Athlete
        </a>
    </div>

    <!-- 🔎 SEARCH + SORT -->
    <div class="d-flex gap-3 mb-3">

        <input class="form-control"
               style="max-width:300px"
               placeholder="Search first or last name..."
               @bind="searchText"
               @bind:event="oninput" />

        <select class="form-select" style="max-width:200px"
                @bind="sortOrder">
            <option value="AZ">A → Z</option>
            <option value="ZA">Z → A</option>
        </select>

    </div>

    @if (athleteList is null)
    {
        <div class="text-muted">Loading...</div>
    }
    else
    {
        <div class="table-card">
            <QuickGrid Class="table table-hover align-middle"
                       Items="FilteredAthletes">

                <PropertyColumn Property="a => a.FirstName" Title="First name" />
                <PropertyColumn Property="a => a.LastName" Title="Last name" />
                <PropertyColumn Property="a => a.Email" Title="Email" />
                <PropertyColumn Property="a => a.PhoneNumber" Title="Phone" />

                <TemplateColumn Title="Actions" Context="a">
                    <div class="d-flex gap-2">

                        <a class="btn btn-sm btn-outline-primary"
                           href="@($"athletes/details?id={a.Id}")">
                            View
                        </a>

                        <a class="btn btn-sm btn-primary"
                           href="@($"athletes/edit?id={a.Id}")">
                            Edit
                        </a>

                        <button class="btn btn-sm btn-outline-danger"
                                @onclick="() => ShowConfirm(a)">
                            Delete
                        </button>

                        @if (athleteToDelete?.Id == a.Id)
                        {
                            <ConfirmModal IsVisible="athleteToDelete is not null"
                                          Message="@($"Delete {athleteToDelete?.FirstName} {athleteToDelete?.LastName}?")"
                                          OnConfirm="DeleteAthlete"
                                          OnCancel="CancelDelete" />
                        }

                    </div>
                </TemplateColumn>

            </QuickGrid>
        </div>
    }
</div>