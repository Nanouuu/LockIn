@page "/athletes/details"
@using LockInCoachWebApp.Models
<PageTitle>Athlete Details</PageTitle>

<div class="container mt-4">
    <h2 class="mb-1">Athlete Details</h2>
    <p class="text-muted mb-4">Full information about the athlete</p>
    <hr />

    @if (Athlete is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="card col-md-5 p-0">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">First Name</dt>
                    <dd class="col-sm-8">@Athlete.FirstName</dd>

                    <dt class="col-sm-4">Last Name</dt>
                    <dd class="col-sm-8">@Athlete.LastName</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Athlete.Email</dd>

                    <dt class="col-sm-4">Phone Number</dt>
                    <dd class="col-sm-8">@Athlete.PhoneNumber</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <a href="@($"athletes/edit?id={Athlete.Id}")" class="btn btn-primary">Edit</a>
                <a href="/athletes" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </div>
    }
</div>